---
import type { MeshtasticLab } from "../data/portfolio";

interface Props { lab: MeshtasticLab; }
const { lab } = Astro.props;
---

<article class="lab-card meshtastic-panel" data-lab-state="planned" data-meshtastic-panel data-local-url="http://127.0.0.1:8787" data-production-url="https://lab.destaben.dev" data-loading-label={lab.loadingLabel} data-unavailable-label={lab.unavailableLabel} data-available-label={lab.availableLabel} data-channel-label={lab.channelLabel} data-last-message-label={lab.lastMessageLabel} data-node-label={lab.nodeLabel} data-time-label={lab.timeLabel} data-hops-label={lab.hopsLabel} data-no-messages-label={lab.noMessagesLabel} aria-labelledby={`${lab.id}-title`}>
  <div class="lab-card-header"><p class="lab-status">{lab.statusLabel}</p><span class="meshtastic-status" data-meshtastic-status role="status">{lab.loadingLabel}</span></div>
  <h3 id={`${lab.id}-title`}>{lab.title}</h3>
  <p>{lab.summary}</p>
  <dl class="meshtastic-readings" data-meshtastic-readings hidden>
    <div><dt>{lab.onlineNodesLabel}</dt><dd data-meshtastic-online>--</dd></div>
    <div><dt>{lab.totalNodesLabel}</dt><dd data-meshtastic-total>--</dd></div>
  </dl>
  <section class="meshtastic-channels" data-meshtastic-channels-section hidden>
    <h4 class="meshtastic-channels-title">{lab.channelsTitle}</h4>
    <ul class="meshtastic-channel-list" data-meshtastic-channels></ul>
    <p class="meshtastic-channels-note">{lab.channelsNote}</p>
  </section>
  <p class="meshtastic-updated" data-meshtastic-updated></p>
  <div class="meshtastic-boundary"><p>{lab.sendingTitle}</p><span>{lab.sendingCopy}</span></div>
  <div class="tag-list">{lab.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
</article>

<script>
  // data-lab-state drives the card styling in global.css: "planned" for loading and
  // unavailable, "active" once a valid status payload has been rendered.
  const requestTimeoutMs = 8000;
  const maxChannels = 16;
  const maxChannelNameLength = 32;
  const maxMessageTextLength = 200;
  const maxCount = 1_000_000;
  const maxHops = 7;
  const localHosts = new Set(["127.0.0.1", "localhost"]);
  // The relay masks the last two characters of a node ID, so only six hexadecimal digits remain visible.
  const maskedNodePattern = /^![0-9A-Fa-f]{6}\*\*$/;

  type Message = { nodeId: string; text: string; time: string; hops?: number };
  type Channel = { name: string; last?: Message };
  type Labels = { channel: string; lastMessage: string; node: string; time: string; hops: string; noMessages: string };
  type ValidStatus = { onlineNodes: number; totalNodes: number; channels: Channel[] | null; refreshed: string };

  const isRecord = (value: unknown): value is Record<string, unknown> =>
    typeof value === "object" && value !== null && !Array.isArray(value);
  const isCount = (value: unknown): value is number =>
    typeof value === "number" && Number.isInteger(value) && value >= 0 && value <= maxCount;

  // Turns every whitespace character into a space, drops control and format characters, collapses
  // runs of spaces, and caps the length in code points so that no surrogate pair is split.
  const cleanText = (value: string, limit: number) =>
    Array.from(value.replace(/\s/g, " ").replace(/\p{Cc}|\p{Cf}/gu, "").replace(/ {2,}/g, " ").trim())
      .slice(0, limit)
      .join("")
      .trim();

  const formatTime = (value: string) => {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat(document.documentElement.lang, { dateStyle: "medium", timeStyle: "short" }).format(date);
  };

  const parseMessage = (raw: unknown): Message | undefined => {
    if (!isRecord(raw)) return undefined;
    const { nodeId, text, time, hops } = raw;
    if (typeof nodeId !== "string" || !maskedNodePattern.test(nodeId)) return undefined;
    if (typeof text !== "string" || typeof time !== "string" || Number.isNaN(Date.parse(time))) return undefined;
    const cleaned = cleanText(text, maxMessageTextLength);
    if (!cleaned) return undefined;
    const validHops = typeof hops === "number" && Number.isInteger(hops) && hops >= 0 && hops <= maxHops ? hops : undefined;
    return { nodeId, text: cleaned, time, hops: validHops };
  };

  const parseChannel = (raw: unknown): Channel | undefined => {
    if (!isRecord(raw) || typeof raw.name !== "string") return undefined;
    const name = cleanText(raw.name, maxChannelNameLength);
    if (!name) return undefined;
    const last = parseMessage(raw.last);
    return last ? { name, last } : { name };
  };

  // Validates the whole payload before any DOM write. A malformed channel entry is dropped on its own.
  const parseStatus = (payload: unknown): ValidStatus => {
    if (!isRecord(payload) || payload.status !== "available") throw new Error("Invalid status payload");
    const { onlineNodes, totalNodes, channels, refreshedAt } = payload;
    if (!isCount(onlineNodes) || !isCount(totalNodes) || onlineNodes > totalNodes) throw new Error("Invalid status payload");
    if (channels !== undefined && !Array.isArray(channels)) throw new Error("Invalid status payload");
    return {
      onlineNodes,
      totalNodes,
      // The relay omits channels when discovery fails; that is a valid payload, not an error.
      channels: Array.isArray(channels)
        ? channels.slice(0, maxChannels).map(parseChannel).filter((channel): channel is Channel => channel !== undefined)
        : null,
      refreshed: typeof refreshedAt === "string" ? formatTime(refreshedAt) : "",
    };
  };

  // Every node is created with createElement and filled with textContent; no markup is parsed from data.
  const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const detail = (term: string, value: string) => {
    const wrap = element("div");
    wrap.append(element("dt", undefined, term), element("dd", undefined, value));
    return wrap;
  };

  const renderChannel = (channel: Channel, labels: Labels) => {
    const item = element("li", "meshtastic-channel");
    item.append(element("p", "meshtastic-channel-label", labels.channel), element("h5", "meshtastic-channel-name", channel.name));
    if (!channel.last) {
      item.append(element("p", "meshtastic-message-empty", labels.noMessages));
      return item;
    }
    const details = element("dl", "meshtastic-message-details");
    details.append(detail(labels.node, channel.last.nodeId), detail(labels.time, formatTime(channel.last.time)));
    if (channel.last.hops !== undefined) details.append(detail(labels.hops, String(channel.last.hops)));
    item.append(
      element("p", "meshtastic-message-label", labels.lastMessage),
      element("p", "meshtastic-message", channel.last.text),
      details,
    );
    return item;
  };

  const initMeshtasticPanel = (panel: HTMLElement) => {
    const baseUrl = (localHosts.has(window.location.hostname) ? panel.dataset.localUrl : panel.dataset.productionUrl) ?? "";
    const state = panel.querySelector<HTMLElement>("[data-meshtastic-status]");
    const readings = panel.querySelector<HTMLElement>("[data-meshtastic-readings]");
    const online = panel.querySelector<HTMLElement>("[data-meshtastic-online]");
    const total = panel.querySelector<HTMLElement>("[data-meshtastic-total]");
    const updated = panel.querySelector<HTMLElement>("[data-meshtastic-updated]");
    const channelsSection = panel.querySelector<HTMLElement>("[data-meshtastic-channels-section]");
    const channelList = panel.querySelector<HTMLElement>("[data-meshtastic-channels]");
    const labels: Labels = {
      channel: panel.dataset.channelLabel ?? "",
      lastMessage: panel.dataset.lastMessageLabel ?? "",
      node: panel.dataset.nodeLabel ?? "",
      time: panel.dataset.timeLabel ?? "",
      hops: panel.dataset.hopsLabel ?? "",
      noMessages: panel.dataset.noMessagesLabel ?? "",
    };

    const showChannels = (channels: Channel[]) => {
      if (channelList) channelList.replaceChildren(...channels.map((channel) => renderChannel(channel, labels)));
      if (channelsSection) channelsSection.hidden = channels.length === 0;
    };

    const showUnavailable = () => {
      panel.dataset.labState = "planned";
      if (state) state.textContent = panel.dataset.unavailableLabel || "Meshtastic unavailable";
      if (readings) readings.hidden = true;
      if (updated) updated.textContent = "";
      showChannels([]);
    };

    const fetchStatus = async (): Promise<unknown> => {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), requestTimeoutMs);
      try {
        const response = await fetch(`${baseUrl}/v1/lab/meshtastic-status`, { signal: controller.signal });
        if (!response.ok) throw new Error(`Unexpected status ${response.status}`);
        return (await response.json()) as unknown;
      } finally {
        window.clearTimeout(timer);
      }
    };

    const load = async () => {
      try {
        // Everything is validated before the first DOM write so a bad payload cannot leave a mixed state.
        const status = parseStatus(await fetchStatus());
        if (online) online.textContent = String(status.onlineNodes);
        if (total) total.textContent = String(status.totalNodes);
        showChannels(status.channels ?? []);
        if (readings) readings.hidden = false;
        if (updated) updated.textContent = status.refreshed;
        if (state) state.textContent = panel.dataset.availableLabel || "Available";
        panel.dataset.labState = "active";
      } catch {
        showUnavailable();
      }
    };

    void load();
  };

  document.querySelectorAll<HTMLElement>("[data-meshtastic-panel]").forEach(initMeshtasticPanel);
</script>
