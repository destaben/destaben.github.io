---
import type { MeshtasticLab } from "../data/portfolio";

interface Props { lab: MeshtasticLab; }
const { lab } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<article class="lab-card meshtastic-panel" data-meshtastic-panel data-local-url="http://127.0.0.1:8787" data-production-url="https://lab.destaben.dev" data-turnstile-site-key={turnstileSiteKey} data-loading-label={lab.loadingLabel} data-unavailable-label={lab.unavailableLabel} data-available-label={lab.availableLabel} data-unavailable-value-label={lab.unavailableValueLabel} data-no-activity-label={lab.noActivityLabel} data-refreshed-label={lab.refreshedLabel} data-send-sending-label={lab.sendSendingLabel} data-send-accepted-label={lab.sendAcceptedLabel} data-send-verification-failed-label={lab.sendVerificationFailedLabel} data-send-rate-limited-label={lab.sendRateLimitedLabel} data-send-failed-label={lab.sendFailedLabel} aria-labelledby={`${lab.id}-title`}>
  <div class="lab-card-header"><p class="lab-status">{lab.statusLabel}</p><span class="meshtastic-state" data-meshtastic-state role="status">{lab.loadingLabel}</span></div>
  <h3 id={`${lab.id}-title`}>{lab.title}</h3>
  <p>{lab.summary}</p>
  <div class="meshtastic-groups" data-meshtastic-groups hidden>
    <section aria-labelledby={`${lab.id}-gateway`}><h4 id={`${lab.id}-gateway`}>{lab.gatewayLabel}</h4><p class="meshtastic-node-name" data-meshtastic-node-name>--</p><dl class="meshtastic-readings"><div><dt>{lab.uptimeLabel}</dt><dd data-meshtastic-uptime>--</dd></div><div><dt>{lab.batteryLabel}</dt><dd data-meshtastic-battery>--</dd></div><div><dt>{lab.voltageLabel}</dt><dd data-meshtastic-voltage>--</dd></div></dl></section>
    <section aria-labelledby={`${lab.id}-network`}><h4 id={`${lab.id}-network`}>{lab.networkLabel}</h4><dl class="meshtastic-readings"><div><dt>{lab.nodesLabel}</dt><dd data-meshtastic-nodes>--</dd></div><div><dt>{lab.channelUtilizationLabel}</dt><dd data-meshtastic-channel-use>--</dd></div><div><dt>{lab.airtimeLabel}</dt><dd data-meshtastic-airtime>--</dd></div></dl></section>
  </div>
  <section class="meshtastic-neighbors" data-meshtastic-neighbors hidden><h4>{lab.nodesLabel}</h4><ul data-meshtastic-neighbor-list></ul></section>
  <section class="meshtastic-activity" aria-labelledby={`${lab.id}-activity`}><div><h4 id={`${lab.id}-activity`}>{lab.latestActivityLabel}</h4><time data-meshtastic-received></time></div><p data-meshtastic-message>{lab.noActivityLabel}</p><dl data-meshtastic-activity-details hidden><div><dt>{lab.senderLabel}</dt><dd data-meshtastic-sender></dd></div><div><dt>{lab.channelLabel}</dt><dd data-meshtastic-channel></dd></div><div data-meshtastic-hops-row hidden><dt>{lab.senderHopsLabel}</dt><dd data-meshtastic-hops></dd></div></dl></section>
  <section class="meshtastic-send" aria-labelledby={`${lab.id}-send`}><h4 id={`${lab.id}-send`}>{lab.sendTitle}</h4><form data-meshtastic-send-form><label>{lab.sendLabel}<textarea data-meshtastic-message-input placeholder={lab.sendPlaceholder} maxlength="237" disabled></textarea></label><div class="meshtastic-turnstile" data-meshtastic-turnstile></div><button data-meshtastic-send-button type="submit" disabled>{lab.sendLabel}</button></form><p class="meshtastic-send-status" data-meshtastic-send-status data-state="unavailable" role="status" aria-live="polite">{lab.sendUnavailableLabel}</p></section>
  <p class="meshtastic-refreshed" data-meshtastic-refreshed></p>
  <div class="home-privacy"><p>{lab.privacyTitle}</p><span>{lab.privacyCopy}</span></div>
  <div class="tag-list">{lab.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
</article>

<script>
  const panel = document.querySelector<HTMLElement>("[data-meshtastic-panel]");
  if (panel) {
    type Status = {
      status?: string;
      gateway?: { name?: string | null; shortName?: string | null; uptimeSeconds?: number | null; batteryPercent?: number | null; voltage?: number | null };
      network?: { nodesOnline?: number | null; nodesTotal?: number | null; channelUtilizationPercent?: number | null; airtimeTxPercent?: number | null };
      neighbors?: { name?: string; shortName?: string | null; snr?: number | null; hopsAway?: number | null }[];
      latestActivity?: { message?: string; sender?: string; channel?: string; receivedAt?: string; senderHopsAway?: number | null } | null;
      refreshedAt?: string;
    };
    const localHosts = new Set(["127.0.0.1", "localhost"]);
    const baseUrl = localHosts.has(window.location.hostname) ? panel.dataset.localUrl : panel.dataset.productionUrl;
    const value = (selector: string, content: string) => {
      const target = panel.querySelector<HTMLElement>(selector);
      if (target) target.textContent = content;
    };
    const unavailableValue = () => panel.dataset.unavailableValueLabel || "Unavailable";
    const number = (input: number | null | undefined, suffix = "") => Number.isFinite(input) ? `${input}${suffix}` : unavailableValue();
    const uptime = (seconds: number | null | undefined) => {
      if (!Number.isFinite(seconds)) return unavailableValue();
      const hours = Math.floor(Number(seconds) / 3600);
      const minutes = Math.floor((Number(seconds) % 3600) / 60);
      return hours ? `${hours}h ${minutes}m` : `${minutes}m`;
    };
    const state = panel.querySelector<HTMLElement>("[data-meshtastic-state]");
    const groups = panel.querySelector<HTMLElement>("[data-meshtastic-groups]");
    const activityDetails = panel.querySelector<HTMLElement>("[data-meshtastic-activity-details]");
    const hopsRow = panel.querySelector<HTMLElement>("[data-meshtastic-hops-row]");
    const neighbors = panel.querySelector<HTMLElement>("[data-meshtastic-neighbors]");
    const neighborList = panel.querySelector<HTMLUListElement>("[data-meshtastic-neighbor-list]");
    const form = panel.querySelector<HTMLFormElement>("[data-meshtastic-send-form]");
    const messageInput = panel.querySelector<HTMLTextAreaElement>("[data-meshtastic-message-input]");
    const sendButton = panel.querySelector<HTMLButtonElement>("[data-meshtastic-send-button]");
    const sendStatus = panel.querySelector<HTMLElement>("[data-meshtastic-send-status]");
    const turnstileContainer = panel.querySelector<HTMLElement>("[data-meshtastic-turnstile]");
    let radioAvailable = false;
    let turnstileToken = "";
    let widgetId: string | null = null;
    const senderReady = () => radioAvailable && Boolean(turnstileToken);
    const updateSender = () => {
      if (messageInput) messageInput.disabled = !senderReady();
      if (sendButton) sendButton.disabled = !senderReady();
    };
    const setSendStatus = (content: string, sendState: "error" | "pending" | "success" | "unavailable") => {
      if (sendStatus) { sendStatus.textContent = content; sendStatus.dataset.state = sendState; }
    };
    const renderTurnstile = () => {
      const siteKey = panel.dataset.turnstileSiteKey;
      if (!siteKey || !turnstileContainer) return;
      const render = () => {
        const turnstile = (window as Window & { turnstile?: { render: (container: HTMLElement, options: Record<string, unknown>) => string } }).turnstile;
        if (!turnstile || widgetId) return;
        widgetId = turnstile.render(turnstileContainer, {
          sitekey: siteKey,
          callback: (token: string) => { turnstileToken = token; updateSender(); },
          "expired-callback": () => { turnstileToken = ""; updateSender(); },
          "error-callback": () => { turnstileToken = ""; updateSender(); },
        });
      };
      const source = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      const existing = document.querySelector<HTMLScriptElement>(`script[src="${source}"]`);
      if (existing) { existing.addEventListener("load", render, { once: true }); render(); return; }
      const script = document.createElement("script");
      script.src = source;
      script.async = true;
      script.addEventListener("load", render, { once: true });
      document.head.append(script);
    };
    const unavailable = () => {
      if (state) state.textContent = panel.dataset.unavailableLabel || "Meshtastic unavailable";
      if (groups) groups.hidden = true;
      if (activityDetails) activityDetails.hidden = true;
      if (hopsRow) hopsRow.hidden = true;
      if (neighbors) neighbors.hidden = true;
      radioAvailable = false;
      updateSender();
      value("[data-meshtastic-message]", panel.dataset.noActivityLabel || "No public activity");
      value("[data-meshtastic-received]", "");
      value("[data-meshtastic-refreshed]", "");
    };
    const load = async () => {
      try {
        const response = await fetch(`${baseUrl}/v1/lab/meshtastic`);
        const status = await response.json() as Status;
        if (!response.ok || status.status !== "available") throw new Error();
        if (state) state.textContent = panel.dataset.availableLabel || "Updated";
        value("[data-meshtastic-node-name]", status.gateway?.name || status.gateway?.shortName || unavailableValue());
        value("[data-meshtastic-uptime]", uptime(status.gateway?.uptimeSeconds));
        value("[data-meshtastic-battery]", number(status.gateway?.batteryPercent, "%"));
        value("[data-meshtastic-voltage]", number(status.gateway?.voltage, " V"));
        value("[data-meshtastic-nodes]", Number.isFinite(status.network?.nodesOnline) && Number.isFinite(status.network?.nodesTotal) ? `${status.network?.nodesOnline}/${status.network?.nodesTotal}` : unavailableValue());
        value("[data-meshtastic-channel-use]", number(status.network?.channelUtilizationPercent, "%"));
        value("[data-meshtastic-airtime]", number(status.network?.airtimeTxPercent, "%"));
        if (groups) groups.hidden = false;
        if (neighborList) {
          neighborList.replaceChildren();
          for (const neighbor of status.neighbors || []) {
            if (!neighbor.name) continue;
            const item = document.createElement("li");
            const title = document.createElement("strong");
            title.textContent = neighbor.shortName ? `${neighbor.name} (${neighbor.shortName})` : neighbor.name;
            const details = document.createElement("span");
            details.textContent = `SNR ${number(neighbor.snr, " dB")} · ${number(neighbor.hopsAway)} hops`;
            item.append(title, details);
            neighborList.append(item);
          }
          if (neighbors) neighbors.hidden = neighborList.childElementCount === 0;
        }
        const activity = status.latestActivity;
        if (activity?.message && activity.sender && activity.channel && activity.receivedAt) {
          value("[data-meshtastic-message]", activity.message); value("[data-meshtastic-sender]", activity.sender); value("[data-meshtastic-channel]", activity.channel);
          const received = panel.querySelector<HTMLTimeElement>("[data-meshtastic-received]");
          if (received) { received.dateTime = activity.receivedAt; received.textContent = new Intl.DateTimeFormat(document.documentElement.lang, { dateStyle: "medium", timeStyle: "short" }).format(new Date(activity.receivedAt)); }
          if (activityDetails) activityDetails.hidden = false;
          if (hopsRow) hopsRow.hidden = !Number.isFinite(activity.senderHopsAway);
          value("[data-meshtastic-hops]", number(activity.senderHopsAway));
        } else {
          if (activityDetails) activityDetails.hidden = true;
          if (hopsRow) hopsRow.hidden = true;
          value("[data-meshtastic-message]", panel.dataset.noActivityLabel || "No public activity");
        }
        if (status.refreshedAt) value("[data-meshtastic-refreshed]", `${panel.dataset.refreshedLabel || "Updated"}: ${new Intl.DateTimeFormat(document.documentElement.lang, { dateStyle: "medium", timeStyle: "short" }).format(new Date(status.refreshedAt))}`);
        radioAvailable = true;
        renderTurnstile();
        updateSender();
      } catch { unavailable(); }
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = messageInput?.value || "";
      if (!senderReady() || !message) return;
      if (sendButton) sendButton.disabled = true;
      setSendStatus(panel.dataset.sendSendingLabel || "Sending message", "pending");
      try {
        const response = await fetch(`${baseUrl}/v1/lab/meshtastic/messages`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message, turnstileToken }),
        });
        if (!response.ok) {
          const body = await response.json().catch(() => null) as { detail?: string } | null;
          const labels: Record<string, string | undefined> = {
            bot_verification_failed: panel.dataset.sendVerificationFailedLabel,
            message_rate_limited: panel.dataset.sendRateLimitedLabel,
            meshtastic_messages_unavailable: panel.dataset.sendFailedLabel,
          };
          throw new Error(labels[body?.detail || ""] || panel.dataset.sendFailedLabel || "Unable to send message");
        }
        if (messageInput) messageInput.value = "";
        setSendStatus(panel.dataset.sendAcceptedLabel || "Message sent", "success");
      } catch (error) {
        setSendStatus(error instanceof Error ? error.message : (panel.dataset.sendFailedLabel || "Unable to send message"), "error");
      } finally { updateSender(); }
    });
    load();
  }
</script>