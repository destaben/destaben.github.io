---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolio, profile, type Locale } from "../data/portfolio";

interface Props {
  locale: Locale;
  post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props as Props;
const { Content } = await render(post);
const content = portfolio[locale];
const copy = locale === "es" ? { label: "Nota técnica" } : { label: "Technical note" };
const date = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={`${post.data.title} | David Estaben`} description={post.data.description} locale={locale}>
  <a class="skip-link" href="#content">{locale === "es" ? "Ir al contenido" : "Skip to content"}</a>
  <header class="site-header">
    <nav class="shell nav" aria-label={locale === "es" ? "Navegación principal" : "Primary navigation"}>
      <a class="brand" href={`/${locale}/`} aria-label="David Estaben home">David Estaben</a>
      <div class="nav-links">
        {content.navigation.map((item) => <a href={`/${locale}/${item.href}`}>{item.label}</a>)}
        <a class="language-link" href={content.switchHref} lang={locale === "es" ? "en" : "es"}>{content.switchLanguage}</a>
      </div>
    </nav>
  </header>
  <main id="content" class="article-page">
    <article class="article-content shell"><header class="article-header"><p class="section-label">{copy.label}</p><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><p class="period">{date.format(post.data.pubDate)}</p><div class="tag-list">{post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div></header><div class="article-body"><Content /></div></article>
  </main>
  <footer class="shell site-footer"><p>{profile.name} / {content.footer}</p></footer>
</BaseLayout>