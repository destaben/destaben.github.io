---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { labSummaries, portfolio, profile, type Locale } from "../data/portfolio";
import type { PageAlternate } from "../config/site";
import { getPublicRepositories } from "../lib/github";
import SignalRelayLab from "./SignalRelayLab.astro";
import ContainerMetricsLab from "./ContainerMetricsLab.astro";
import HomeAssistantLab from "./HomeAssistantLab.astro";
import MeshtasticLab from "./MeshtasticLab.astro";
import type { MeshtasticStatusLab } from "../data/portfolio";
import PrinterLab from "./PrinterLab.astro";
import SystemGraphic from "./SystemGraphic.astro";
import SectionLabel from "./react/SectionLabel";
import BlurText from "./react/BlurText";
import ShinyText from "./react/ShinyText";
import Magnet from "./react/Magnet";
import Reveal from "./react/Reveal";
import GlitchBackdrop from "./react/GlitchBackdrop";

interface Props {
  alternates?: readonly PageAlternate[];
  locale: Locale;
}

const { alternates, locale } = Astro.props;
const content = portfolio[locale];
const labDisplayOrder = ["home-status", "container-metrics", "meshtastic", "meshtastic-status", "printer", "signal-relay"];
const labs = content.labs
  .map((lab) => ({ ...lab, summary: labSummaries[locale][lab.id] ?? lab.summary }))
  .sort((left, right) => labDisplayOrder.indexOf(left.id) - labDisplayOrder.indexOf(right.id));
// The mesh status (node counts and each public channel's last message) is rendered inside the Meshtastic section, not as its own card.
const meshtasticStatus = labs.find((lab) => lab.kind === "meshtastic-status") as MeshtasticStatusLab | undefined;
const sectionIds = locale === "es"
  ? { work: "trabajo", lab: "laboratorio", projects: "proyectos", writing: "bitacora", experience: "trayectoria", contact: "contacto" }
  : { work: "work", lab: "lab", projects: "projects", writing: "notes", experience: "experience", contact: "contact" };
const repositories = await getPublicRepositories();
const posts = (await getCollection("blog") as CollectionEntry<"blog">[])
  .filter((post: CollectionEntry<"blog">) => !post.data.draft && post.data.locale === locale)
  .sort((left: CollectionEntry<"blog">, right: CollectionEntry<"blog">) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf());
const updatedDate = new Intl.DateTimeFormat(locale, { month: "short", year: "numeric" });
const publishedDate = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" });
const writingPrefix = locale === "es" ? "/es/bitacora/" : "/en/notes/";
---

<BaseLayout title={`David Estaben | ${locale === "es" ? "Sistemas y fiabilidad" : "Systems & Reliability"}`} description={content.description} locale={locale} alternates={alternates}>
  <a class="skip-link" href="#content">{locale === "es" ? "Ir al contenido" : "Skip to content"}</a>
  <header class="site-header">
    <nav class="shell nav" aria-label={locale === "es" ? "Navegación principal" : "Primary navigation"}>
      <a class="brand" href={`/${locale}/`} aria-label={locale === "es" ? "Inicio de David Estaben" : "David Estaben home"}>David Estaben</a>
      <div class="nav-links">
        {content.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="language-link" href={content.switchHref} lang={locale === "es" ? "en" : "es"}>{content.switchLanguage}</a>
      </div>
    </nav>
  </header>
  <main id="content">
    <section class="shell hero" aria-labelledby="hero-title">
      <div class="hero-copy-wrap">
        <p class="eyebrow"><span class="signal-dot"></span><ShinyText client:load text={content.hero.eyebrow} color="#4a6469" shineColor="#0b1f23" speed={3.5} delay={1.5} /></p>
        <h1 id="hero-title"><BlurText as="span" client:load text={content.hero.title} delay={45} stepDuration={0.22} blur={6} distance={20} /></h1>
        <p class="hero-copy">{content.hero.copy}</p>
        <div class="actions"><Magnet client:visible padding={70} magnetStrength={4}><a class="button button-primary" href={`#${sectionIds.work}`}>{content.hero.primary}</a></Magnet><Magnet client:visible padding={70} magnetStrength={4}><a class="button" href={`#${sectionIds.lab}`}>{content.hero.secondary}</a></Magnet></div>
        <ul class="proof-list">{content.proof.map((item) => <li>{item}</li>)}</ul>
      </div>
      <SystemGraphic />
    </section>

    <section class="section section-ink" id={sectionIds.work} aria-labelledby="work-title"><div class="glitch-backdrop" aria-hidden="true"><GlitchBackdrop client:visible /></div><div class="shell"><div class="section-heading"><p class="section-label"><SectionLabel client:visible text={`01 / ${content.work.label}`} /></p><h2 id="work-title"><BlurText as="span" client:visible text={content.work.title} delay={35} stepDuration={0.2} blur={6} distance={20} /></h2></div><BlurText client:visible className="section-copy" text={content.work.copy} delay={8} stepDuration={0.16} blur={4} distance={10} /><Reveal client:visible className="case-grid">{content.work.cases.map((study) => <article class="case-study"><p class="case-number">{study.number}</p><h3>{study.title}</h3><p>{study.context}</p><p class="decision">{study.decision}</p><div class="tag-list">{study.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</Reveal></div></section>

    <section class="section" id={sectionIds.lab} aria-labelledby="lab-title"><div class="shell"><div class="lab-heading"><p class="section-label"><SectionLabel client:visible text={`02 / ${content.lab.label}`} /></p><div><h2 id="lab-title"><BlurText as="span" client:visible text={content.lab.title} delay={35} stepDuration={0.2} blur={6} distance={20} /></h2><BlurText client:visible className="section-copy" text={content.lab.copy} delay={8} stepDuration={0.16} blur={4} distance={10} /></div></div><div class="lab-grid">{labs.filter((lab) => lab.kind !== "meshtastic-status").map((lab) => lab.kind === "relay" ? <SignalRelayLab lab={lab} locale={locale} /> : lab.kind === "metrics" ? <ContainerMetricsLab lab={lab} /> : lab.kind === "meshtastic" ? <MeshtasticLab lab={lab} status={meshtasticStatus} /> : lab.kind === "printer" ? <PrinterLab lab={lab} /> : <HomeAssistantLab lab={lab} />)}</div></div></section>

    <section class="section section-ink" id={sectionIds.projects} aria-labelledby="projects-title"><div class="shell"><div class="section-heading"><p class="section-label"><SectionLabel client:visible text="03 / GitHub" /></p><div><h2 id="projects-title"><BlurText as="span" client:visible text={locale === "es" ? "Código para explorar." : "Code to explore."} delay={35} stepDuration={0.2} blur={6} distance={20} /></h2><BlurText client:visible className="section-copy" text={locale === "es" ? "Repositorios públicos que acompañan el trabajo seleccionado." : "Public repositories that accompany the selected work."} delay={8} stepDuration={0.16} blur={4} distance={10} /></div></div><div class="projects-toolbar" aria-label={locale === "es" ? "Filtrar proyectos" : "Filter projects"}><button class="filter-button" type="button" data-filter="all" aria-pressed="true">{locale === "es" ? "Todos" : "All"}</button><button class="filter-button" type="button" data-filter="original" aria-pressed="false">{locale === "es" ? "Originales" : "Original"}</button><button class="filter-button" type="button" data-filter="fork" aria-pressed="false">Forks</button><button class="filter-button" type="button" data-filter="archived" aria-pressed="false">{locale === "es" ? "Archivados" : "Archived"}</button></div><p class="archive-empty" hidden>{locale === "es" ? "No hay repositorios en esta categoría." : "There are no repositories in this category."}</p><Reveal client:visible className="projects-grid">{repositories.map((repository) => <article class="project" data-type={repository.archived ? "archived" : repository.fork ? "fork" : "original"}><p class="period">{locale === "es" ? "Actualizado" : "Updated"} {updatedDate.format(new Date(repository.updatedAt))}</p><h3><a href={repository.url} target="_blank" rel="noreferrer">{repository.name}</a></h3><p class="meta">{repository.language ?? (locale === "es" ? "Repositorio" : "Repository")} / {repository.stars} stars / {repository.forksCount} forks</p><p>{repository.description ?? "-"}</p><div class="tag-list">{repository.fork && <span class="tag">fork</span>}{repository.archived && <span class="tag">archived</span>}{repository.topics.map((topic) => <span class="tag">{topic}</span>)}</div></article>)}</Reveal></div></section>

    <section class="section" id={sectionIds.writing} aria-labelledby="writing-title"><div class="shell"><div class="section-heading"><p class="section-label"><SectionLabel client:visible text={`04 / ${locale === "es" ? "Bitácora" : "Notes"}`} /></p><div><h2 id="writing-title"><BlurText as="span" client:visible text={locale === "es" ? "Notas desde el trabajo de sistemas." : "Notes from systems work."} delay={35} stepDuration={0.2} blur={6} distance={20} /></h2><BlurText client:visible className="section-copy" text={locale === "es" ? "Notas breves sobre sistemas, operación y decisiones de arquitectura." : "Short notes on systems, operations, and architecture decisions."} delay={8} stepDuration={0.16} blur={4} distance={10} /></div></div><Reveal client:visible className="writing-list">{posts.map((post) => <article class="note-card"><p class="period">{publishedDate.format(post.data.pubDate)}</p><h3><a href={`${writingPrefix}${post.id.split("/").at(-1)}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="tag-list">{post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div><a class="text-link" href={`${writingPrefix}${post.id.split("/").at(-1)}/`}>{locale === "es" ? "Leer nota" : "Read note"}</a></article>)}</Reveal></div></section>

    <section class="section section-warm" id={sectionIds.experience} aria-labelledby="experience-title"><div class="shell"><div class="section-heading"><p class="section-label"><SectionLabel client:visible text={`05 / ${content.experience.label}`} /></p><h2 id="experience-title"><BlurText as="span" client:visible text={content.experience.title} delay={35} stepDuration={0.2} blur={6} distance={20} /></h2></div><ol class="timeline">{content.experience.items.map((item) => <li class="entry"><p class="period">{item.period}</p><article><h3>{item.role}</h3><p class="meta">{item.company}</p><p>{item.focus}</p></article></li>)}</ol></div></section>
    <section class="section contact-section" id={sectionIds.contact} aria-labelledby="contact-title"><div class="shell contact-layout"><p class="section-label"><SectionLabel client:visible text={`06 / ${content.contact.label}`} /></p><div><h2 id="contact-title"><BlurText as="span" client:visible text={content.contact.title} delay={35} stepDuration={0.2} blur={6} distance={20} /></h2><BlurText client:visible className="section-copy" text={content.contact.copy} delay={8} stepDuration={0.16} blur={4} distance={10} /><dl class="contact-channels"><div><dt>{content.contact.emailLabel}</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div><div><dt>{content.contact.networkLabel}</dt><dd>{profile.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>)}</dd></div></dl><p class="contact-response">{content.contact.response}</p><Magnet client:visible padding={70} magnetStrength={4}><a class="button button-primary" href={`mailto:${profile.email}`}>{content.contact.action}</a></Magnet></div></div></section>
  </main>
  <footer class="shell site-footer"><p>{profile.name} / {content.footer}</p></footer>
  <script>
    // Cursor-following spotlight on cards: only sets two CSS variables; the gradient lives in global.css.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && matchMedia("(hover: hover)").matches) {
      document.querySelectorAll<HTMLElement>(".case-study, .project, .note-card").forEach((card) => {
        card.addEventListener("pointermove", (event) => {
          const box = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${event.clientX - box.left}px`);
          card.style.setProperty("--my", `${event.clientY - box.top}px`);
        });
        card.addEventListener("pointerleave", () => {
          card.style.removeProperty("--mx");
          card.style.removeProperty("--my");
        });
      });
    }
    // Permalink buttons: every section and lab card already has an id; this copies its full URL.
    const spanish = document.documentElement.lang.startsWith("es");
    const copyLabel = spanish ? "Copiar enlace" : "Copy link";
    const status = document.createElement("p");
    status.className = "anchor-copy-label";
    status.setAttribute("role", "status");
    document.body.append(status);
    let statusTimer: number | undefined;
    document.querySelectorAll<HTMLElement>("section.section[id], .lab-card[id], .meshtastic-status-panel[id]").forEach((target) => {
      const heading = target.matches(".meshtastic-status-panel") ? target.querySelector("h4") : target.matches(".lab-card") ? target.querySelector("h3") : target.querySelector("h2");
      if (!heading) return;
      // Animated headings render their text twice (one screen-reader copy, one decorative); collapse that before naming anything.
      const raw = (heading.textContent ?? "").replace(/\u00A0/g, " ").trim();
      const half = raw.length / 2;
      const title = raw.length % 2 === 0 && raw.slice(0, half) === raw.slice(half) ? raw.slice(0, half) : raw;
      heading.setAttribute("aria-label", title);
      heading.classList.add("has-anchor");
      const button = document.createElement("button");
      button.type = "button";
      button.className = "anchor-copy";
      const glyph = document.createElement("span");
      glyph.setAttribute("aria-hidden", "true");
      glyph.textContent = "#";
      const label = document.createElement("span");
      label.className = "anchor-copy-label";
      label.textContent = `${copyLabel}: ${title}`;
      button.append(glyph, label);
      button.addEventListener("click", async () => {
        const url = `${location.origin}${location.pathname}#${target.id}`;
        let copied = true;
        try { await navigator.clipboard.writeText(url); } catch { copied = false; history.replaceState(null, "", `#${target.id}`); }
        const message = copied ? (spanish ? "Enlace copiado" : "Link copied") : (spanish ? "No se pudo copiar; el enlace está en la barra de direcciones" : "Could not copy; the link is in the address bar");
        button.dataset.state = copied ? "copied" : "failed";
        button.title = message;
        status.textContent = message;
        clearTimeout(statusTimer);
        statusTimer = window.setTimeout(() => { document.querySelectorAll<HTMLElement>(".anchor-copy[data-state]").forEach((other) => { delete other.dataset.state; other.removeAttribute("title"); }); status.textContent = ""; }, 2400);
      });
      heading.append(button);
    });
    const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const projects = document.querySelectorAll<HTMLElement>("[data-type]");
    const empty = document.querySelector<HTMLElement>(".archive-empty");
    filters.forEach((filter) => filter.addEventListener("click", () => {
      const type = filter.dataset.filter;
      let visible = 0;
      filters.forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
      projects.forEach((project) => {
        const matches = type === "all" || project.dataset.type === type;
        project.hidden = !matches;
        visible += Number(matches);
      });
      if (empty) empty.hidden = visible > 0;
    }));
  </script>
</BaseLayout>