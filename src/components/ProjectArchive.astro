---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../data/portfolio";
import type { PublicRepository } from "../lib/github";

interface Props {
  locale: Locale;
  repositories: PublicRepository[];
}

const { locale, repositories } = Astro.props;
const copy = locale === "es"
  ? { title: "Archivo de proyectos", description: "Repositorios públicos que acompañan el trabajo seleccionado.", home: "Inicio", heading: "Código para explorar.", all: "Todos", original: "Originales", fork: "Forks", archived: "Archivados", updated: "Actualizado", empty: "No hay repositorios en esta categoría.", language: "Repositorio" }
  : { title: "Project archive", description: "Public repositories that accompany the selected work.", home: "Home", heading: "Code to explore.", all: "All", original: "Original", fork: "Forks", archived: "Archived", updated: "Updated", empty: "There are no repositories in this category.", language: "Repository" };
const updatedDate = new Intl.DateTimeFormat(locale, { month: "short", year: "numeric" });
---

<BaseLayout title={`David Estaben | ${copy.title}`} description={copy.description} locale={locale}>
  <main class="archive-page">
    <nav class="shell archive-nav" aria-label={locale === "es" ? "Navegación" : "Navigation"}><a class="brand" href={`/${locale}/`}><img src="/images/site/brand-mark.svg" alt="" /><span>DE<span class="brand-muted">/SYS</span></span></a><div><a href={`/${locale}/`}>{copy.home}</a><a class="language-link" href={locale === "es" ? "/en/projects/" : "/es/proyectos/"}>{locale === "es" ? "English" : "Español"}</a></div></nav>
    <section class="shell archive-hero"><p class="section-label">01 / GitHub</p><h1>{copy.heading}</h1><p class="section-copy">{copy.description}</p></section>
    <section class="shell archive-content" aria-label={copy.title}>
      <div class="projects-toolbar" aria-label={locale === "es" ? "Filtrar proyectos" : "Filter projects"}>
        <button class="filter-button" type="button" data-filter="all" aria-pressed="true">{copy.all}</button><button class="filter-button" type="button" data-filter="original" aria-pressed="false">{copy.original}</button><button class="filter-button" type="button" data-filter="fork" aria-pressed="false">{copy.fork}</button><button class="filter-button" type="button" data-filter="archived" aria-pressed="false">{copy.archived}</button>
      </div>
      <p class="archive-empty" hidden>{copy.empty}</p>
      <div class="projects-grid">{repositories.map((repository) => <article class="project" data-type={repository.archived ? "archived" : repository.fork ? "fork" : "original"}><p class="period">{copy.updated} {updatedDate.format(new Date(repository.updatedAt))}</p><h2><a href={repository.url} target="_blank" rel="noreferrer">{repository.name}</a></h2><p class="meta">{repository.language ?? copy.language} / {repository.stars} stars / {repository.forksCount} forks</p><p>{repository.description ?? "-"}</p><div class="tag-list">{repository.fork && <span class="tag">fork</span>}{repository.archived && <span class="tag">archived</span>}{repository.topics.map((topic) => <span class="tag">{topic}</span>)}</div></article>)}</div>
    </section>
  </main>
  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const projects = document.querySelectorAll<HTMLElement>("[data-type]");
    const empty = document.querySelector<HTMLElement>(".archive-empty");
    filters.forEach((filter) => filter.addEventListener("click", () => {
      const type = filter.dataset.filter;
      let visible = 0;
      filters.forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
      projects.forEach((project) => {
        const matches = type === "all" || project.dataset.type === type;
        project.hidden = !matches;
        visible += Number(matches);
      });
      if (empty) empty.hidden = visible > 0;
    }));
  </script>
</BaseLayout>