---
import { relayNodeCopy, type RelayLab } from "../data/portfolio";
import CopySpark from "./react/CopySpark";
import { CircleCheck, KeyRound, LockKeyhole, MessageSquareText, Radio, Send, Smartphone, X } from "@lucide/astro";

interface Props {
  lab: RelayLab;
  locale: "es" | "en";
}

const { lab, locale } = Astro.props;
const nodeCopy = relayNodeCopy[locale];
---

<article id={lab.id} class="lab-card relay-panel" data-lab-state={lab.status} aria-labelledby={`${lab.id}-title`} data-relay-panel data-relay-local-url="http://127.0.0.1:8787" data-relay-production-url="https://lab.destaben.dev" data-copied-label={lab.copiedLabel} data-online-label={lab.onlineLabel} data-offline-label={lab.offlineLabel} data-node-up-label={nodeCopy.up} data-node-down-label={nodeCopy.down} data-node-unavailable-label={nodeCopy.unavailable} data-node-pending-label={nodeCopy.sessionPending} data-preparing-label={lab.wizard.preparingLabel} data-unavailable-label={lab.wizard.unavailableLabel} data-inbox-empty-label={lab.inboxEmpty} data-queued-label={lab.wizard.queuedLabel} data-delivered-label={lab.wizard.deliveredLabel} data-failed-label={lab.wizard.failedLabel} data-unconfirmed-label={lab.wizard.unconfirmedLabel} data-route-waiting-label={lab.wizard.routeWaitingLabel} data-route-source-ready-label={lab.wizard.routeSourceReadyLabel} data-route-encrypted-label={lab.wizard.routeEncryptedLabel} data-route-routing-label={lab.wizard.routeRoutingLabel} data-route-received-label={lab.wizard.routeReceivedLabel} data-route-confirmed-label={lab.wizard.routeConfirmedLabel} data-route-delivery-failed-label={lab.wizard.routeDeliveryFailedLabel} data-route-outbound-failed-label={lab.wizard.routeOutboundFailedLabel} data-route-unknown-failed-label={lab.wizard.routeUnknownFailedLabel} data-route-unconfirmed-label={lab.wizard.routeUnconfirmedLabel} data-telegram-configured-label={lab.wizard.telegramConfiguredLabel}>
  <div class="lab-card-header">
    <p class="lab-status">{lab.statusLabel}</p>
    <span class="relay-availability" data-relay-availability data-state="checking" role="status"><span data-relay-status-dot></span><span data-relay-status-text>{lab.checkingLabel}</span></span>
  </div>
  <h3 id={`${lab.id}-title`}><a href="https://reticulum.network" target="_blank" rel="noreferrer">{lab.title}</a></h3>
  <p>{lab.summary}</p>
  <div class="tag-list">{lab.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
  <CopySpark client:visible className="relay-address"><div><p class="relay-label">{lab.addressLabel}</p><code data-relay-address>{lab.addressPending}</code></div><button type="button" data-copy-address aria-label={locale === "es" ? "Copiar dirección Reticulum" : "Copy Reticulum address"} disabled>{lab.copyLabel}</button></CopySpark>
  <button class="relay-explore-button" type="button" data-open-wizard><MessageSquareText size={17} aria-hidden="true" />{lab.wizard.openLabel}</button>
  <div class="relay-inbox"><p class="relay-label">{lab.inboxLabel}</p><ul data-relay-inbox aria-live="polite"><li>{lab.inboxEmpty}</li></ul><p class="relay-note">{lab.inboxNote}</p><section class="relay-nodes" aria-labelledby={`${lab.id}-nodes`}><p id={`${lab.id}-nodes`} class="relay-label">{nodeCopy.label}</p><ul data-relay-nodes aria-live="polite"><li>{nodeCopy.unavailable}</li></ul><p class="relay-note">{nodeCopy.note}</p></section></div>
</article>

<dialog class="relay-dialog" data-relay-dialog aria-labelledby={`${lab.id}-wizard-title`}>
  <div class="relay-dialog-surface">
    <form method="dialog" class="relay-dialog-close"><button type="submit" aria-label={lab.wizard.closeLabel} title={lab.wizard.closeLabel}><X size={19} aria-hidden="true" /></button></form>
    <header class="relay-wizard-heading"><p class="relay-label">{lab.wizard.title}</p><h4 id={`${lab.id}-wizard-title`}>{lab.wizard.copy}</h4></header>
    <ol class="relay-route" aria-label={lab.wizard.title}>{lab.wizard.steps.map((step, index) => <li class="relay-route-step" data-route-step={index} data-state="waiting"><span class="relay-route-marker">{index === 0 ? <KeyRound size={20} aria-hidden="true" /> : index === 1 ? <Radio size={20} aria-hidden="true" /> : index === 2 ? <LockKeyhole size={20} aria-hidden="true" /> : <CircleCheck size={20} aria-hidden="true" />}</span><div><strong>{step}</strong><span data-route-state>{lab.wizard.routeWaitingLabel}</span></div></li>)}</ol>
    <div class="relay-route-details">
      <article><KeyRound size={19} aria-hidden="true" /><div><p>{lab.wizard.sourceLabel}</p><code data-relay-source>{lab.wizard.sourcePending}</code></div></article>
      <article><Radio size={19} aria-hidden="true" /><div><p>{lab.wizard.destinationLabel}</p><code data-relay-destination>{lab.addressPending}</code></div></article>
      <article><Radio size={19} aria-hidden="true" /><div><p>{nodeCopy.sessionLabel}</p><strong data-relay-session-node>{nodeCopy.sessionPending}</strong></div></article>
      <article><Smartphone size={19} aria-hidden="true" /><div><p>{lab.wizard.telegramLabel}</p><strong data-telegram-status>{lab.wizard.telegramUnavailableLabel}</strong><span>{lab.wizard.telegramCopy}</span></div></article>
    </div>
    <form class="relay-message-form" data-relay-message-form>
      <label>{lab.wizard.messageLabel}<textarea data-relay-message maxlength="280" placeholder={lab.wizard.messagePlaceholder} required></textarea></label>
      <div><button type="submit"><Send size={16} aria-hidden="true" />{lab.wizard.sendLabel}</button><p data-relay-session-status role="status"></p></div>
    </form>
  </div>
</dialog>

<script>
  import { createRelayLive } from "../lib/relay-live.mjs";
  import { composerControls, renderAddress, renderInbox, renderNodes, routeSteps, sessionStatusText } from "../lib/relay-view.mjs";

  const relayPanel = document.querySelector<HTMLElement>("[data-relay-panel]");
  if (relayPanel) {
    const localHosts = new Set(["127.0.0.1", "localhost"]);
    const relayUrl = localHosts.has(window.location.hostname) ? relayPanel.dataset.relayLocalUrl : relayPanel.dataset.relayProductionUrl;
    const address = relayPanel.querySelector<HTMLElement>("[data-relay-address]");
    const inbox = relayPanel.querySelector<HTMLElement>("[data-relay-inbox]");
    const nodes = relayPanel.querySelector<HTMLElement>("[data-relay-nodes]");
    const copyButton = relayPanel.querySelector<HTMLButtonElement>("[data-copy-address]");
    const availability = relayPanel.querySelector<HTMLElement>("[data-relay-availability]");
    const availabilityText = relayPanel.querySelector<HTMLElement>("[data-relay-status-text]");
    const openWizardButton = relayPanel.querySelector<HTMLButtonElement>("[data-open-wizard]");
    const dialog = document.querySelector<HTMLDialogElement>("[data-relay-dialog]");
    const sessionStatus = dialog?.querySelector<HTMLElement>("[data-relay-session-status]");
    const destination = dialog?.querySelector<HTMLElement>("[data-relay-destination]");
    const telegramStatus = dialog?.querySelector<HTMLElement>("[data-telegram-status]");
    const sessionNode = dialog?.querySelector<HTMLElement>("[data-relay-session-node]");
    const messageForm = dialog?.querySelector<HTMLFormElement>("[data-relay-message-form]");
    const messageInput = dialog?.querySelector<HTMLTextAreaElement>("[data-relay-message]");
    const submitButton = messageForm?.querySelector<HTMLButtonElement>("button[type='submit']");
    const routeStepElements = Array.from(dialog?.querySelectorAll<HTMLElement>("[data-route-step]") || []);

    const setRelayAvailability = (isOnline: boolean) => {
      if (availability) availability.dataset.state = isOnline ? "online" : "offline";
      if (availabilityText) availabilityText.textContent = isOnline ? relayPanel.dataset.onlineLabel || "Signal Relay online" : relayPanel.dataset.offlineLabel || "Signal Relay offline";
    };

    copyButton?.addEventListener("click", async () => {
      if (!address || !address.textContent || copyButton.disabled) return;
      await navigator.clipboard.writeText(address.textContent);
      copyButton.textContent = relayPanel.dataset.copiedLabel || "Copied";
    });

    const renderRoute = (state: string, errorCode = "") => {
      routeSteps(state, errorCode, relayPanel.dataset).forEach((step, index) => {
        const element = routeStepElements[index];
        if (!element) return;
        element.dataset.state = step.state;
        const status = element.querySelector<HTMLElement>("[data-route-state]");
        if (status) status.textContent = step.label;
      });
    };

    const setSessionState = (state: string, errorCode = "") => {
      if (!sessionStatus) return;
      sessionStatus.textContent = sessionStatusText(state, relayPanel.dataset);
      sessionStatus.dataset.state = state;
      renderRoute(state, errorCode);
    };

    // The helper owns the network rules (polling, aborts, send outcomes, cooldown) and reports only what to show.
    const relay = createRelayLive({
      relayUrl,
      fetch,
      documentTarget: document,
      windowTarget: window,
      view: {
        setAvailability: setRelayAvailability,
        setAddress(value) {
          renderAddress({ address, destination, copyButton }, value);
        },
        setInbox: (data) => renderInbox(document, inbox, data, relayPanel.dataset),
        setNodes: (data) => renderNodes(document, nodes, data, relayPanel.dataset),
        setTelegram(enabled) {
          if (telegramStatus && enabled) telegramStatus.textContent = relayPanel.dataset.telegramConfiguredLabel || "Telegram configured";
        },
        setSessionNode(alias) {
          if (sessionNode) sessionNode.textContent = alias || relayPanel.dataset.nodePendingLabel || "Waiting for route confirmation";
        },
        setSessionState,
        setSessionNotice(kind) {
          if (!sessionStatus) return;
          sessionStatus.textContent = kind === "preparing"
            ? relayPanel.dataset.preparingLabel || "Preparing session"
            : relayPanel.dataset.unavailableLabel || "Educational sending is unavailable";
          // The notice replaces any earlier state so its styling cannot carry over (for example, an unconfirmed warning).
          sessionStatus.dataset.state = kind;
        },
        setComposer(mode) {
          const { inputDisabled, submitDisabled } = composerControls(mode);
          if (messageInput) messageInput.disabled = inputDisabled;
          if (submitButton) submitButton.disabled = submitDisabled;
        },
      },
    });

    openWizardButton?.addEventListener("click", () => dialog?.showModal());

    messageForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!messageInput) return;
      void relay.send(() => messageInput.value);
    });
  }
</script>
