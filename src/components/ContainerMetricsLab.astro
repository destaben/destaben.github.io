---
import { ChevronLeft, ChevronRight, RotateCcw } from "@lucide/astro";
import type { MetricsLab } from "../data/portfolio";

interface Props { lab: MetricsLab; }
const { lab } = Astro.props;
---

<article class="lab-card metrics-panel" data-metrics-panel data-local-url="http://127.0.0.1:8787" data-production-url="https://lab.destaben.dev" data-loading-label={lab.loadingLabel} data-unavailable-label={lab.unavailableLabel} data-no-data-label={lab.noDataLabel} aria-labelledby={`${lab.id}-title`}>
  <div class="lab-card-header"><p class="lab-status">{lab.statusLabel}</p><span class="metrics-window" data-metrics-window></span></div>
  <h3 id={`${lab.id}-title`}>{lab.title}</h3>
  <p>{lab.summary}</p>
  <div class="metrics-toolbar">
    <div class="metrics-mode" role="group" aria-label={lab.titleLabel}>
      <button type="button" data-metric="cpu" aria-pressed="true">{lab.cpuLabel}</button>
      <button type="button" data-metric="memory" aria-pressed="false">{lab.memoryLabel}</button>
    </div>
    <div class="metrics-navigation">
      <button type="button" data-offset="-1" aria-label={lab.previousLabel} title={lab.previousLabel}><ChevronLeft size={17} aria-hidden="true" /></button>
      <button type="button" data-offset="0" aria-label={lab.nowLabel} title={lab.nowLabel}><RotateCcw size={15} aria-hidden="true" /></button>
      <button type="button" data-offset="1" aria-label={lab.nextLabel} title={lab.nextLabel}><ChevronRight size={17} aria-hidden="true" /></button>
    </div>
  </div>
  <form class="metrics-range" data-metrics-range>
    <label>{lab.startLabel}<input type="datetime-local" data-metrics-start required /></label>
    <label>{lab.endLabel}<input type="datetime-local" data-metrics-end required /></label>
    <button type="submit">{lab.applyLabel}</button>
  </form>
  <div class="metrics-chart" data-metrics-chart role="img" aria-live="polite"></div>
  <fieldset class="metrics-services"><legend>{lab.servicesLabel}</legend><div data-metrics-services></div></fieldset>
</article>

<script>
  const panel = document.querySelector<HTMLElement>("[data-metrics-panel]");
  if (panel) {
    type Series = { name: string; values: [number, number][] };
    const localHosts = new Set(["127.0.0.1", "localhost"]);
    const baseUrl = localHosts.has(window.location.hostname) ? panel.dataset.localUrl : panel.dataset.productionUrl;
    const chart = panel.querySelector<HTMLElement>("[data-metrics-chart]");
    const services = panel.querySelector<HTMLElement>("[data-metrics-services]");
    const windowLabel = panel.querySelector<HTMLElement>("[data-metrics-window]");
    const rangeForm = panel.querySelector<HTMLFormElement>("[data-metrics-range]");
    const startInput = panel.querySelector<HTMLInputElement>("[data-metrics-start]");
    const endInput = panel.querySelector<HTMLInputElement>("[data-metrics-end]");
    const colors = ["#d8f04b", "#ff7955", "#577075", "#0b1f23", "#198754", "#b28a20"];
    const range = 6 * 60 * 60;
    let metric = "cpu";
    let end = Math.floor(Date.now() / 1000);
    let start = end - range;
    let allSeries: Series[] = [];
    let visible = new Set<string>();

    const formatValue = (value: number) => metric === "cpu" ? `${(value * 100).toFixed(value < .1 ? 2 : 1)}%` : `${(value / 1024 / 1024).toFixed(0)} MiB`;
    const scaleCeiling = (peak: number) => {
      const target = Math.max(peak * 1.15, metric === "cpu" ? 0.005 : 1);
      const magnitude = 10 ** Math.floor(Math.log10(target));
      const normalized = target / magnitude;
      const step = [1, 2, 2.5, 5, 10].find((candidate) => normalized <= candidate) || 10;
      return step * magnitude;
    };
    const dateInputValue = (timestamp: number) => {
      const date = new Date(timestamp * 1000);
      const pad = (value: number) => String(value).padStart(2, "0");
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
    };
    const syncRangeInputs = () => {
      if (startInput) startInput.value = dateInputValue(start);
      if (endInput) endInput.value = dateInputValue(end);
    };
    const render = () => {
      const active = allSeries.filter((series) => visible.has(series.name));
      if (!chart) return;
      if (!active.length) { chart.textContent = panel.dataset.noDataLabel || "No samples"; return; }
      const points = active.flatMap((series) => series.values);
      const max = scaleCeiling(Math.max(...points.map(([, value]) => value)));
      const duration = end - start;
      const pathFor = (series: Series) => series.values.map(([time, value], index) => `${index ? "L" : "M"}${48 + ((time - start) / duration) * 780},${190 - (value / max) * 152}`).join(" ");
      const formatter = new Intl.DateTimeFormat(document.documentElement.lang, { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" });
      const ticks = Array.from({ length: 5 }, (_, index) => {
        const time = start + (duration * index) / 4;
        const x = 48 + (780 * index) / 4;
        return `<text class="metrics-time" x="${x}" y="218" text-anchor="${index === 0 ? "start" : index === 4 ? "end" : "middle"}">${formatter.format(new Date(time * 1000))}</text>`;
      }).join("");
      chart.innerHTML = `<svg viewBox="0 0 860 240" preserveAspectRatio="none" aria-hidden="true"><path class="metrics-grid-line" d="M48 38H828M48 114H828M48 190H828"/><path class="metrics-axis" d="M48 22V190H828"/>${active.map((series, index) => `<path class="metrics-line" style="stroke:${colors[index % colors.length]}" d="${pathFor(series)}"/>`).join("")}<text x="0" y="42">${formatValue(max)}</text><text x="18" y="194">0</text>${ticks}</svg>`;
    };
    const renderServices = () => {
      if (!services) return;
      services.replaceChildren(...allSeries.map((series, index) => {
        const label = document.createElement("label");
        const input = document.createElement("input");
        input.type = "checkbox";
        input.checked = visible.has(series.name);
        input.addEventListener("change", () => { input.checked ? visible.add(series.name) : visible.delete(series.name); render(); });
        const swatch = document.createElement("span");
        swatch.className = "metrics-swatch";
        swatch.style.background = colors[index % colors.length];
        label.append(input, swatch, document.createTextNode(series.name));
        return label;
      }));
    };
    const load = async () => {
      if (!baseUrl || !chart) return;
      chart.textContent = panel.dataset.loadingLabel || "Loading";
      try {
        const response = await fetch(`${baseUrl}/v1/lab/metrics?metric=${metric}&start=${start}&end=${end}&step=120`);
        if (!response.ok) throw new Error();
        const data = await response.json() as { series?: Series[] };
        const selected = visible;
        allSeries = Array.isArray(data.series) ? data.series : [];
        visible = selected.size ? new Set(allSeries.filter((series) => selected.has(series.name)).map((series) => series.name)) : new Set(allSeries.map((series) => series.name));
        if (windowLabel) windowLabel.textContent = new Intl.DateTimeFormat(document.documentElement.lang, { hour: "2-digit", minute: "2-digit", month: "short", day: "numeric" }).formatRange(new Date(start * 1000), new Date(end * 1000));
        renderServices(); render();
      } catch { chart.textContent = panel.dataset.unavailableLabel || "Metrics unavailable"; }
    };
    panel.querySelectorAll<HTMLButtonElement>("[data-metric]").forEach((button) => button.addEventListener("click", () => { metric = button.dataset.metric || "cpu"; panel.querySelectorAll("[data-metric]").forEach((item) => item.setAttribute("aria-pressed", String(item === button))); load(); }));
    rangeForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const requestedStart = startInput?.valueAsNumber ? Math.floor(startInput.valueAsNumber / 1000) : NaN;
      const requestedEnd = endInput?.valueAsNumber ? Math.floor(endInput.valueAsNumber / 1000) : NaN;
      const now = Math.floor(Date.now() / 1000);
      if (!Number.isFinite(requestedStart) || !Number.isFinite(requestedEnd) || requestedStart >= requestedEnd || requestedEnd > now || requestedEnd - requestedStart > 604800) return;
      start = requestedStart; end = requestedEnd; load();
    });
    panel.querySelectorAll<HTMLButtonElement>("[data-offset]").forEach((button) => button.addEventListener("click", () => { const offset = Number(button.dataset.offset); const duration = end - start; end = offset === 0 ? Math.floor(Date.now() / 1000) : Math.min(Math.floor(Date.now() / 1000), end + offset * duration); start = end - duration; syncRangeInputs(); load(); }));
    syncRangeInputs();
    load();
  }
</script>