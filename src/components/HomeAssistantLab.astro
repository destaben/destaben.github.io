---
import type { HomeStatusLab } from "../data/portfolio";

interface Props { lab: HomeStatusLab; }
const { lab } = Astro.props;
---

<article class="lab-card home-panel" data-home-status-panel data-local-url="http://127.0.0.1:8787" data-production-url="https://lab.destaben.dev" data-loading-label={lab.loadingLabel} data-unavailable-label={lab.unavailableLabel} data-available-label={lab.availableLabel} aria-labelledby={`${lab.id}-title`}>
  <div class="lab-card-header"><p class="lab-status">{lab.statusLabel}</p><span class="home-status-state" data-home-status-state role="status">{lab.loadingLabel}</span></div>
  <h3 id={`${lab.id}-title`}>{lab.title}</h3>
  <p>{lab.summary}</p>
  <dl class="home-readings" data-home-readings hidden>
    <div><dt>{lab.temperatureLabel}</dt><dd data-home-temperature>--</dd></div>
    <div><dt>{lab.humidityLabel}</dt><dd data-home-humidity>--</dd></div>
    <div><dt>{lab.airQualityLabel}</dt><dd class="air-quality" data-home-air-quality data-state="unknown">--</dd></div>
  </dl>
  <p class="home-updated" data-home-updated></p>
  <div class="home-privacy"><p>{lab.privacyTitle}</p><span>{lab.privacyCopy}</span></div>
  <div class="tag-list">{lab.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
</article>

<script>
  const panel = document.querySelector<HTMLElement>("[data-home-status-panel]");
  if (panel) {
    type Status = { status?: string; temperatureC?: number; humidityPercent?: number; airQuality?: "good" | "regular" | "bad"; refreshedAt?: string };
    const localHosts = new Set(["127.0.0.1", "localhost"]);
    const baseUrl = localHosts.has(window.location.hostname) ? panel.dataset.localUrl : panel.dataset.productionUrl;
    const state = panel.querySelector<HTMLElement>("[data-home-status-state]");
    const readings = panel.querySelector<HTMLElement>("[data-home-readings]");
    const temperature = panel.querySelector<HTMLElement>("[data-home-temperature]");
    const humidity = panel.querySelector<HTMLElement>("[data-home-humidity]");
    const airQuality = panel.querySelector<HTMLElement>("[data-home-air-quality]");
    const updated = panel.querySelector<HTMLElement>("[data-home-updated]");
    const unavailable = () => {
      if (state) state.textContent = panel.dataset.unavailableLabel || "Status unavailable";
      if (readings) readings.hidden = true;
      if (updated) updated.textContent = "";
    };
    const load = async () => {
      try {
        const response = await fetch(`${baseUrl}/v1/lab/home-status`);
        const status = await response.json() as Status;
        if (!response.ok || status.status !== "available" || !Number.isFinite(status.temperatureC) || !Number.isFinite(status.humidityPercent) || !status.airQuality) throw new Error();
        if (state) state.textContent = panel.dataset.availableLabel || "Available";
        if (temperature) temperature.textContent = `${status.temperatureC} °C`;
        if (humidity) humidity.textContent = `${status.humidityPercent}%`;
        if (airQuality) {
          airQuality.dataset.state = status.airQuality;
          airQuality.textContent = panel.dataset[`${status.airQuality}Label`] || status.airQuality;
        }
        if (readings) readings.hidden = false;
        if (updated && status.refreshedAt) updated.textContent = new Intl.DateTimeFormat(document.documentElement.lang, { dateStyle: "medium", timeStyle: "short" }).format(new Date(status.refreshedAt));
      } catch { unavailable(); }
    };
    load();
  }
</script>