---
import { site, type PageAlternate } from "../config/site";
import "../styles/global.css";

interface Props {
  alternates?: readonly PageAlternate[];
  description?: string;
  locale?: string;
  title?: string;
}

const { alternates = [], description = site.description, locale = site.locale, title = site.title } = Astro.props;
const ogLocale = locale === "en" ? "en_US" : "es_ES";
// Cookieless GoatCounter runs only in production builds with a site code. The code is a public identifier, not a secret.
const goatcounterCode = import.meta.env.PUBLIC_GOATCOUNTER_CODE || "";
const showGoatCounter = import.meta.env.PROD && /^[a-z0-9-]+$/i.test(goatcounterCode);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <noscript><style is:inline>[data-blur-piece], [data-reveal] { opacity: 1 !important; filter: none !important; transform: none !important; }</style></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url)} />
    {alternates.map(({ hreflang, path }) => <link rel="alternate" hreflang={hreflang} href={new URL(path, site.url)} />)}
    <link rel="alternate" type="application/rss+xml" title={site.title} href={new URL("/rss.xml", site.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, site.url)} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL(site.image, site.url)} />
    <link rel="icon" href="/images/site/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {showGoatCounter && <script is:inline async data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
  </body>
</html>