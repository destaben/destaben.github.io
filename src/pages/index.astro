---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, experience, profile, skills } from "../data/portfolio";
import { getPublicRepositories } from "../lib/github";

const repositories = await getPublicRepositories();
const updatedDate = new Intl.DateTimeFormat("en", {
  month: "short",
  year: "numeric",
});
---

<BaseLayout>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header">
    <nav class="shell nav" aria-label="Main navigation">
      <a class="brand" href="#top">DE / SRE</a>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#experience">Experience</a>
        <a href="#education">Education</a>
        <a href="#projects">Projects</a>
      </div>
    </nav>
  </header>
  <main id="content">
    <section class="shell hero" id="top" aria-labelledby="name">
      <div>
        <p class="eyebrow">{profile.location}</p>
        <h1 id="name">{profile.name}</h1>
        <p class="hero-role">{profile.role} at <a href={profile.companyUrl}>{profile.company}</a></p>
        <p class="hero-copy">{profile.summary}</p>
        <div class="actions">
          <a class="button button-primary" href={`mailto:${profile.email}`}>Get in touch</a>
          <a class="button" href="#projects">View projects</a>
        </div>
      </div>
      <img class="hero-image" src={profile.image} alt={`Portrait of ${profile.name}`} width="960" height="1200" />
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="shell">
        <div class="section-heading"><p class="section-label">01 / Profile</p><h2 id="about-title">Reliable systems are built deliberately.</h2></div>
        <p class="section-copy">I work at the junction of software and infrastructure, helping teams replace repetitive operations with observable, maintainable systems.</p>
        <div class="social-links" style="margin-top: 1.5rem">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          {profile.socialLinks.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>)}
        </div>
      </div>
    </section>

    <section class="section" id="skills" aria-labelledby="skills-title">
      <div class="shell">
        <div class="section-heading"><p class="section-label">02 / Toolkit</p><h2 id="skills-title">Practical infrastructure skills.</h2></div>
        <div class="skills-grid">
          {skills.map((skill) => <article class="skill"><img src={skill.image} alt="" width="42" height="42" loading="lazy" /> <h3>{skill.url ? <a href={skill.url}>{skill.name}</a> : skill.name}</h3><p>{skill.summary}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-title">
      <div class="shell">
        <div class="section-heading"><p class="section-label">03 / Work</p><h2 id="experience-title">Experience in production.</h2></div>
        <ol class="timeline">{experience.map((job) => <li class="entry"><p class="period">{job.period}</p><article><h3>{job.role}</h3><p class="meta"><a href={job.url}>{job.company}</a> / {job.location}</p><p>{job.overview}</p><ul>{job.responsibilities.map((responsibility) => <li>{responsibility}</li>)}</ul></article></li>)}</ol>
      </div>
    </section>

    <section class="section" id="education" aria-labelledby="education-title">
      <div class="shell">
        <div class="section-heading"><p class="section-label">04 / Education</p><h2 id="education-title">Foundations that travel.</h2></div>
        <ol class="timeline">{education.map((item) => <li class="entry"><p class="period">{item.period}</p><article><h3>{item.qualification}</h3><p>{item.institution}</p></article></li>)}</ol>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="shell">
        <div class="section-heading"><p class="section-label">05 / GitHub</p><h2 id="projects-title">Public work, automatically updated.</h2></div>
        <p class="section-copy">Every public repository from <a href="https://github.com/destaben">github.com/destaben</a> is collected when this site builds.</p>
        <div class="projects-toolbar" aria-label="Filter projects">
          <button class="filter-button" type="button" data-filter="all" aria-pressed="true">All</button>
          <button class="filter-button" type="button" data-filter="original" aria-pressed="false">Original</button>
          <button class="filter-button" type="button" data-filter="fork" aria-pressed="false">Forks</button>
          <button class="filter-button" type="button" data-filter="archived" aria-pressed="false">Archived</button>
        </div>
        <div class="projects-grid">
          {repositories.map((repository) => <article class="project" data-type={repository.archived ? "archived" : repository.fork ? "fork" : "original"}>
            <p class="period">Updated {updatedDate.format(new Date(repository.updatedAt))}</p>
            <h3><a href={repository.url} target="_blank" rel="noreferrer">{repository.name}</a></h3>
            <p class="meta">{repository.language ?? "Repository"} / {repository.stars} stars / {repository.forksCount} forks</p>
            <p>{repository.description ?? "No description provided."}</p>
            <div class="tag-list">
              {repository.fork && <span class="tag">fork</span>}
              {repository.archived && <span class="tag">archived</span>}
              {repository.topics.map((topic) => <span class="tag">{topic}</span>)}
            </div>
          </article>)}
        </div>
      </div>
    </section>
  </main>
  <footer class="shell site-footer"><p>David Estabén / {profile.role} / <a href={`mailto:${profile.email}`}>{profile.email}</a></p></footer>
  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const projectCards = document.querySelectorAll<HTMLElement>("[data-type]");
    filters.forEach((filter) => filter.addEventListener("click", () => {
      const type = filter.dataset.filter;
      filters.forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
      projectCards.forEach((project) => { project.hidden = type !== "all" && project.dataset.type !== type; });
    }));
  </script>
</BaseLayout>
