# Public bootstrap transports for Signal Relay Reticulum mode.
# This is a complete valid RNS configuration. Keep deployment-specific identities
# and additional interfaces outside Git.

[reticulum]
  enable_transport = No
  share_instance = Yes

[interfaces]

[[RNS Arborisis]]
  type = TCPClientInterface
  enabled = yes
  target_host = rns.arborisis.com
  target_port = 4242

[[RNS NodeRage]]
  type = TCPClientInterface
  enabled = yes
  target_host = rns.noderage.org
  target_port = 4242

[[RNS Spain Quixote]]
  type = TCPClientInterface
  enabled = yes
  target_host = reticulum.quixote.network
  target_port = 4242

[[RNS Mari-El]]
  type = TCPClientInterface
  enabled = yes
  target_host = rns.mari-el.net
  target_port = 4242

[[RNS UTN]]
  type = TCPClientInterface
  enabled = yes
  target_host = rns.utn.lol
  target_port = 4965

[[MKLabs]]
  type = TCPClientInterface
  enabled = yes
  target_host = lab.mikelcalvo.net
  target_port = 4242

[[RNS Wisco]]
  type = TCPClientInterface
  enabled = yes
  target_host = rns.wisco.network
  target_port = 4242

[[BSDHell]]
  type = TCPClientInterface
  enabled = yes
  target_host = reticulum.bsdhell.com
  target_port = 4242
