SIGNAL_RELAY_MODE=demo
SIGNAL_RELAY_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
SIGNAL_RELAY_RATE_LIMIT=10
SIGNAL_RELAY_RATE_WINDOW_SECONDS=60
SIGNAL_RELAY_RETICULUM_CONFIG_DIR=
SIGNAL_RELAY_STORAGE_DIR=./data
# Private JSON mapping from configured TCP client interface names to unique public aliases.
# The interface names remain private; the public status endpoint exposes aliases, URLs and states.
SIGNAL_RELAY_PUBLIC_TCP_NODE_ALIASES=
# Private JSON mapping from each public alias to its intentionally public TCP URL.
# Both mappings must define the same aliases. Use tcp://host:port URLs only; do not include
# non-global literal IP addresses, IPv4-embedding IPv6 forms (NAT64, 6to4, Teredo), credentials, paths, queries, fragments, stray ? or # (even when
# empty), non-ASCII or whitespace characters, percent-escapes, or trailing dots.
SIGNAL_RELAY_PUBLIC_TCP_NODE_URLS=
# Requires a verified external Reticulum route and an anti-bot control before enabling.
SIGNAL_RELAY_LAB_SEND_ENABLED=false
# Separate Reticulum client configuration used by the ephemeral browser sender.
SIGNAL_RELAY_LAB_SENDER_CONFIG_DIR=
# Set both values to receive each incoming LXMF message through Telegram.
SIGNAL_RELAY_TELEGRAM_BOT_TOKEN=
SIGNAL_RELAY_TELEGRAM_CHAT_ID=
# Home Assistant is reached only through Nginx's internal listener. Use a
# dedicated long-lived access token and the three explicitly allowed sensor IDs.
SIGNAL_RELAY_HOME_ASSISTANT_TOKEN=
SIGNAL_RELAY_HOME_ASSISTANT_TEMPERATURE_ENTITY_ID=
SIGNAL_RELAY_HOME_ASSISTANT_HUMIDITY_ENTITY_ID=
SIGNAL_RELAY_HOME_ASSISTANT_AIR_QUALITY_ENTITY_ID=
# Deliberately delayed public projection; do not reduce below 900 seconds.
SIGNAL_RELAY_HOME_ASSISTANT_CACHE_SECONDS=900
# Private JSON map of the fixed Meshtastic public projection keys to Home
# Assistant entity IDs. It includes the local public node name and five
# sanitized public MediumFast activity entries. Keep actual IDs out of Git and
# browser code.
SIGNAL_RELAY_MESHTASTIC_ENTITY_IDS=
# Cache for the Meshtastic send and lab projection (GET /v1/lab/meshtastic), which bounds Home Assistant reads.
# Do not reduce below 15. The status panel has its own cache: SIGNAL_RELAY_MESHTASTIC_STATUS_CACHE_SECONDS.
SIGNAL_RELAY_MESHTASTIC_CACHE_SECONDS=30
# Required to enable public MediumFast broadcasts. Keep it deployment-only.
SIGNAL_RELAY_MESHTASTIC_TURNSTILE_SECRET=
# Per-client cooldown for accepted broadcasts. Do not reduce below 60.
SIGNAL_RELAY_MESHTASTIC_MESSAGE_COOLDOWN_SECONDS=300
# The Meshtastic status panel reads only the gateway, nodes_online and nodes_total keys of
# SIGNAL_RELAY_MESHTASTIC_ENTITY_IDS. Malformed Meshtastic or Home Assistant entity IDs stop the
# relay at startup with an error that names the setting and never echoes the value.
# Channel entities are discovered by prefix; empty means the gateway entity ID plus "_channel_".
SIGNAL_RELAY_MESHTASTIC_CHANNEL_PREFIX=
# Default-deny: only channels whose name is listed here are published, matched case-insensitively
# after whitespace, underscore and hyphen normalization. Empty publishes no channels at all.
# Each name: 1 to 32 letters, digits, spaces, underscores, or hyphens.
SIGNAL_RELAY_MESHTASTIC_CHANNEL_ALLOWLIST=
# Extra layers, applied after the allowlist. Comma-separated names with the same rules as the allowlist.
# A channel listed here is never published, even if allowlisted.
# Direct-message tokens in the entity ID or name also exclude a channel, but that is a heuristic: confirm
# every direct-message entity with docs/MESHTASTIC-INVENTORY.md step 5b and deny it here before go-live.
SIGNAL_RELAY_MESHTASTIC_CHANNEL_DENYLIST=
# JSON object mapping published fields to the attribute names that carry them on the host, e.g.
# {"text": "...", "node_id": "...", "timestamp": "...", "hop_start": "...", "hop_limit": "..."}.
# Without node_id no message is published. Verify the names with docs/MESHTASTIC-INVENTORY.md.
SIGNAL_RELAY_MESHTASTIC_CHANNEL_FIELDS=
# Deliberately delayed public status projection. Values below 900 seconds are raised to 900.
SIGNAL_RELAY_MESHTASTIC_STATUS_CACHE_SECONDS=900
